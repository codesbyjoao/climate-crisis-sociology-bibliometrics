## Importing bib file generated in Script.r

df <- readRDS("final_climate.rds")

## Ensuring the data is well to be analysed

df$PY <- as.numeric(df$PY)
df1 <- df[df$PY >= 2020 & df$PY <= 2024, ]

# Checking the possible remaining NaN values

colSums(is.na(df1))

# Extracting author countries of affiliation

M <- metaTagExtraction(df1, Field = "AU_CO", aff.disamb = TRUE)

# Checking function results

unique(M$AU_CO)
M[is.na(M$AU_CO), c("AU", "C1", "AU_UN")]

# Cleaning and standardizing countries of affiliation considering database-specific format

M$C1 <- stri_trans_general(M$C1, "Latin-ASCII")

M$C1 <- str_remove_all(
  M$C1,
  regex(
    "EQUALLY CONTRIBUTED\\.?|CO-LAST AUTHOR|INDEPENDENT SCHOLAR|INDEPENDENT RESEARCHER",
    ignore_case = TRUE
  )
)

M$C1 <- str_replace_all(M$C1, "\\s*;\\s*", "; ")

M$C1 <- str_squish(M$C1)


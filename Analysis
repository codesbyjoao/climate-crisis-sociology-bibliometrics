extract_countries <- function(x) {

  found <- countries[
    str_detect(str_to_upper(x), fixed(countries))
  ]

  found <- unique(found)

  paste(found, collapse = ";")
}

df2$AU_CO <- sapply(df2$C1, extract_countries)

